{
  "schemaVersion": 1,
  "id": "fabric-item-api-v1",
  "name": "Fabric Item API (v1)",
  "version": "14.8.0+plexus.neoforge.26.3",
  "environment": "*",
  "license": "Apache-2.0",
  "icon": "assets/fabric-item-api-v1/icon.png",
  "contact": {
    "sources": "https://github.com/Sinytra/ForgifiedFabricAPI"
  },
  "authors": [
    "FabricMC",
    "Sinytra"
  ],
  "depends": {
    "fabricloader": ">=0.19.3",
    "fabric-api-base": "*",
    "fabric-resource-loader-v1": "*",
    "minecraft": "26.3"
  },
  "description": "Hooks for items",
  "entrypoints": {
    "client": [
      "net.fabricmc.fabric.impl.client.item.ClientItemEventHooks"
    ]
  },
  "mixins": [
