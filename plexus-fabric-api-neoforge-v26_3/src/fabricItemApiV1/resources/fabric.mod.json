    {
      "config": "fabric-item-api-v1.client.mixins.json",
      "environment": "client"
    }
  ],
  "accessWidener": "fabric-item-api-v1.classtweaker",
  "custom": {
    "fabric-api:module-lifecycle": "stable",
    "plexusmodloader:host-module": {
      "host": "neoforge",
      "minecraft": "26.3",
      "replaces": "14.8.0"
    }
  }
