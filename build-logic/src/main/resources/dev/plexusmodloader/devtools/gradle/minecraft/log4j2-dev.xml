<?xml version="1.0" encoding="UTF-8"?>
<!--
  Log4j configuration for development runs started by runClient / runServer / serverBootSmokeTest.
  Log4j comes from Minecraft's own libraries. Poly Mod Loader's loader classes log through SLF4J into the same
  context as the game, so one log shows Poly Mod Loader phases and game output in order.
-->
<!-- shutdownHook="disable" keeps logging available while Poly Mod Loader shutdown tasks run. -->
<Configuration status="WARN" shutdownHook="disable">
  <Appenders>
    <Console name="Console" target="SYSTEM_OUT">
      <PatternLayout pattern="[%d{HH:mm:ss}] [%t/%level] (%logger{1}) %msg{nolookups}%n"/>
    </Console>
    <RollingRandomAccessFile name="LatestLog" fileName="logs/latest.log" filePattern="logs/%d{yyyy-MM-dd}-%i.log.gz">
      <PatternLayout pattern="[%d{HH:mm:ss}] [%t/%level] (%logger) %msg{nolookups}%n"/>
      <Policies>
        <TimeBasedTriggeringPolicy/>
        <OnStartupTriggeringPolicy/>
      </Policies>
    </RollingRandomAccessFile>
  </Appenders>
  <Loggers>
    <Root level="info">
      <AppenderRef ref="Console"/>
      <AppenderRef ref="LatestLog"/>
    </Root>
  </Loggers>
</Configuration>
