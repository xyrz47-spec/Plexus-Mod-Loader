{
  "schemaVersion": 1,
  "id": "transform_demo_mod",
  "version": "0.1.0",
  "name": "Transform Demo Mod",
  "environment": "both",
  "minecraft": ["26.2"],
  "depends": {
    "poly": ">=1.0.0 <2.0.0"
  },
  "capabilities": ["internal.bytecode.transform", "internal.callsite.intercept", "internal.member.access"],
  "transforms": [
    {
      "id": "transform_demo_mod:storage_format_name",
      "minecraft": "26.2",
      "sides": ["client", "dedicated_server"],
      "target": {
        "owner": "net/minecraft/world/level/storage/LevelStorageSource",
        "method": "getName",
        "descriptor": "()Ljava/lang/String;"
      },
      "action": {
        "type": "replace_returned_string_constant",
        "expected": "Anvil",
        "replacement": "Anvil (Poly Mod Loader transform demo)"
      },
      "onFailure": "disable_rule"
    },
    {
      "id": "transform_demo_mod:tick_start_nanos",
      "minecraft": "26.2",
      "sides": ["client", "dedicated_server"],
      "target": {
        "owner": "net/minecraft/server/MinecraftServer",
        "method": "tickServer",
        "descriptor": "(Ljava/util/function/BooleanSupplier;)V"
      },
      "action": {
        "type": "redirect_call",
        "invokedOwner": "net/minecraft/util/Util",
        "invokedName": "getNanos",
        "invokedDescriptor": "()J",
        "ordinal": 0,
        "hookOwner": "com.example.poly.transformdemo.TickHooks",
        "hookMethod": "tickStartNanos"
      },
      "after": ["poly:server_tick_events"],
      "onFailure": "disable_rule"
    }
  ],
  "accessWidenings": [
    {
      "minecraft": "26.2",
      "sides": ["client", "dedicated_server"],
      "owner": "net/minecraft/server/MinecraftServer",
      "kind": "field",
      "name": "tickCount",
      "descriptor": "I",
      "access": ["accessible"],
      "onFailure": "skip"
    }
  ]
}
